# Postgres connection string. On Vercel, adding a Neon database (Storage tab)
# sets this for you. Locally, run `vercel env pull .env.local` or paste it here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Code teammates must enter to create an account. The very first account
# can be created without it. Leave empty to close sign-ups.
TEAM_INVITE_CODE=""

# Optional: your office time zone (decides what "today" is) and the first
# day of the week (0 = Sunday, 1 = Monday, 6 = Saturday).
APP_TIMEZONE="UTC"
WEEK_START="1"
